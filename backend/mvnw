#!/bin/sh
# ----------------------------------------------------------------------------
# Maven Wrapper Script for Agri Marketplace Backend (Linux/macOS/CI)
# ----------------------------------------------------------------------------

MAVEN_DIR="$HOME/.m2/wrapper/dists/apache-maven-3.9.6"
MAVEN_BIN="$MAVEN_DIR/apache-maven-3.9.6/bin/mvn"

if [ ! -x "$MAVEN_BIN" ]; then
    echo "[Agri Marketplace] Provisioning Apache Maven 3.9.6 wrapper..."
    mkdir -p "$MAVEN_DIR"
    curl -fsSL -o "$MAVEN_DIR/maven.zip" "https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/3.9.6/apache-maven-3.9.6-bin.zip"
    unzip -q -o "$MAVEN_DIR/maven.zip" -d "$MAVEN_DIR"
    rm -f "$MAVEN_DIR/maven.zip"
    chmod +x "$MAVEN_BIN"
fi

exec "$MAVEN_BIN" "$@"
